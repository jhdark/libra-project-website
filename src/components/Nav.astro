---
import LibraLogo from './LibraLogo.astro';
import LinkIcon from './LinkIcon.astro';
import { url } from '../lib/url';

const links = [
  { href: 'experiments', label: 'Experiments' },
  { href: 'people', label: 'People' },
  { href: 'publications', label: 'Publications' },
  { href: 'data', label: 'Data & Code' },
  { href: 'news', label: 'News' },
];
// Highlight the section the current page belongs to.
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
---

<!-- One bar: the wordmark left, the sections right. -->
<header class="site-header">
  <div class="wrap bar">
    <a href={url()} class="home" aria-label="LIBRA home"><LibraLogo /></a>
    <button id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark theme" class="theme-switch">
      <span class="track" aria-hidden="true">
        <span class="knob">
          <svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
        </span>
      </span>
    </button>
    <button id="nav-toggle" type="button" class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">Menu</button>
    <nav id="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <a class="github" href="https://github.com/LIBRA-project" target="_blank" rel="noopener" aria-label="LIBRA on GitHub">
            <span class="mark"><LinkIcon name="github" /></span><span class="github-label">GitHub</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Light or dark, saved for next time. The head script in Base.astro applies
  // it before the page paints; the switch is on when the theme is dark.
  const themeBtn = document.getElementById('theme-toggle');
  const sync = () => themeBtn?.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'dark'));
  sync();
  themeBtn?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('theme', theme); } catch {}
    sync();
  });

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') === true;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header { border-bottom: var(--rule-bar) solid var(--color-rule-2); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: var(--space-xl); padding-block: var(--space-md); }
  .home { text-decoration: none; }
  /* The theme switch sits at the far end of the bar, after the sections: a
     square track whose knob slides right for dark, carrying a sun or moon. */
  .theme-switch { order: 3; display: inline-flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: transparent; color: var(--color-ink); cursor: pointer; }
  .track { position: relative; display: block; width: 56px; height: 30px; border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-control); background: var(--color-paper-2); }
  .theme-switch:hover .track { background: var(--color-paper-3); }
  .theme-switch:focus-visible { outline: none; }
  .theme-switch:focus-visible .track { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .knob { position: absolute; top: 3px; left: 3px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 1px; background: var(--color-ink); color: var(--color-paper); transition: transform var(--dur-micro) var(--ease-out); }
  [aria-checked='true'] .knob { transform: translateX(26px); }
  .knob svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .knob .moon, [aria-checked='true'] .knob .sun { display: none; }
  [aria-checked='true'] .knob .moon { display: block; }
  @media (prefers-reduced-motion: reduce) { .knob { transition: none; } }
  nav a.github { display: flex; align-items: center; gap: var(--space-xs); }
  nav a.github:hover { color: var(--color-accent); }
  .mark { display: block; width: 22px; height: 22px; }
  .github-label { display: none; }
  nav { margin-left: auto; }
  .menu-btn { display: none; min-height: 44px; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-control); background: transparent; color: var(--color-ink); font: 600 0.875rem/1 var(--font-display); cursor: pointer; }
  .menu-btn:hover { background: var(--color-paper-2); }
  .menu-btn:active { background: var(--color-paper-3); }
  ul { display: flex; gap: var(--space-xl); list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding-block: var(--space-sm); font: 600 0.9375rem/1.2 var(--font-display); color: var(--color-ink); text-decoration: none; white-space: nowrap; }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  nav a[aria-current='page'] { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; }
  @media (max-width: 60rem) {
    .bar { column-gap: var(--space-md); flex-wrap: wrap; }
    .home { flex: 1 1 0; min-width: 0; }
    .menu-btn { display: inline-flex; align-items: center; flex-shrink: 0; order: 2; }
    .theme-switch { order: 1; }
    .github-label { display: inline; }
    nav { order: 4; margin-left: 0; }
    nav { display: none; flex-basis: 100%; margin-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
    nav:global(.open) { display: block; }
    ul { flex-direction: column; gap: 0; }
    li + li { border-top: var(--rule-hair) solid var(--color-rule); }
  }
</style>
