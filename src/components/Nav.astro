---
import LibraLogo from './LibraLogo.astro';
import { url } from '../lib/url';

const links = [
  { href: 'experiments', label: 'Experiments' },
  { href: 'people', label: 'People' },
  { href: 'publications', label: 'Publications' },
  { href: 'data', label: 'Data & Code' },
  { href: 'news', label: 'News' },
];
// Highlight the section the current page belongs to.
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').split('/')[1] ?? '';
---

<!-- One bar: the wordmark left, the sections right. -->
<header class="site-header">
  <div class="wrap bar">
    <a href={url()} class="home" aria-label="LIBRA home"><LibraLogo /></a>
    <button id="nav-toggle" type="button" class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">Menu</button>
    <nav id="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a href="https://github.com/LIBRA-project" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') === true;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header { border-bottom: var(--rule-bar) solid var(--color-rule-2); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: var(--space-xl); padding-block: var(--space-md); }
  .home { text-decoration: none; }
  .menu-btn { display: none; min-height: 44px; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-control); background: transparent; color: var(--color-ink); font: 600 0.875rem/1 var(--font-display); cursor: pointer; }
  .menu-btn:hover { background: var(--color-paper-2); }
  .menu-btn:active { background: var(--color-paper-3); }
  ul { display: flex; gap: var(--space-xl); list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding-block: var(--space-sm); font: 600 0.9375rem/1.2 var(--font-display); color: var(--color-ink); text-decoration: none; white-space: nowrap; }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  nav a[aria-current='page'] { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; }
  @media (max-width: 60rem) {
    .bar { column-gap: var(--space-md); flex-wrap: wrap; }
    .home { flex: 1 1 0; min-width: 0; }
    .menu-btn { display: inline-flex; align-items: center; flex-shrink: 0; }
    nav { display: none; flex-basis: 100%; margin-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
    nav:global(.open) { display: block; }
    ul { flex-direction: column; gap: 0; }
    li + li { border-top: var(--rule-hair) solid var(--color-rule); }
  }
</style>
