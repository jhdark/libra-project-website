---
import { url } from '../lib/url';

const explore = [
  { href: url('experiments'), label: 'Experiments' },
  { href: url('people'), label: 'People' },
  { href: url('publications'), label: 'Publications' },
  { href: url('data'), label: 'Data & Code' },
  { href: url('news'), label: 'News' },
];
const year = new Date().getFullYear();
---

<!-- Colophon: the parent centre, one paragraph of credits and links, the sitemap, the legal line. -->
<footer class="colophon">
  <div class="container">
    <p class="parent"><a href="https://www.psfc.mit.edu/" target="_blank" rel="noopener">MIT Plasma Science and Fusion Center</a></p>
    <p class="credits">
      LIBRA is a project of the MIT Plasma Science and Fusion Center, advancing tritium breeding technologies for fusion energy.
      Data lives in the <a class="link" href="https://zenodo.org/communities/libra-project/records" target="_blank" rel="noopener">Zenodo community</a>,
      code in the <a class="link" href="https://github.com/LIBRA-project" target="_blank" rel="noopener">GitHub organisation</a>,
      and analysis in the <a class="link" href="https://libra-toolbox.readthedocs.io/en/latest/" target="_blank" rel="noopener">libra-toolbox docs</a>.
      Write to <a class="link" href="mailto:remidm@mit.edu">remidm@mit.edu</a>.
    </p>
    <nav aria-label="Footer">
      <ul>
        {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="legal">© {year} LIBRA project, MIT Plasma Science and Fusion Center.</p>
  </div>
</footer>

<style>
  .colophon { border-top: var(--rule-bar) solid var(--color-rule-2); padding-block: var(--space-2xl) var(--space-xl); }
  /* The parent centre is named in type: PSFC logo files are not kept in this
     repository (see CLAUDE.md, "Design system"). */
  .parent { font: 600 1.25rem/1.2 var(--font-display); }
  .parent a { color: var(--color-ink); text-decoration: none; }
  .parent a:hover { color: var(--color-accent); text-decoration: underline; }
  .credits { margin-top: var(--space-xl); max-width: 68ch; color: var(--color-ink-2); }
  ul { list-style: none; margin: var(--space-xl) 0 0; padding: var(--space-md) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule); font: 600 0.9375rem/1.5 var(--font-display); }
  nav a { color: var(--color-ink); text-decoration: none; }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--color-accent); }
  .legal { margin-top: var(--space-lg); font-size: 0.875rem; color: var(--color-muted); }
</style>
