---
// A line diagram from src/assets/diagrams/, set inline so it takes the site's
// type and colour tokens. The SVGs draw with the dg-* classes styled below.
interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const files = import.meta.glob<string>('../assets/diagrams/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = files[`../assets/diagrams/${name}.svg`];
if (!svg) throw new Error(`Diagram ${name}.svg is not in src/assets/diagrams/`);
---
<figure class="diagram">
  <div class="sheet" role="img" aria-label={alt} set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram { margin: var(--space-xl) 0; }
  .sheet { padding: var(--space-md); background: var(--color-sheet); border: var(--rule-hair) solid var(--color-rule); }
  .sheet :global(svg) { display: block; width: 100%; height: auto; }
  /* On phones the labels would be too small to read, so the sheet keeps a
     legible width and scrolls inside its frame; the page itself does not. */
  @media (max-width: 40rem) {
    .sheet { overflow-x: auto; }
    .sheet :global(svg) { min-width: 640px; }
  }
  figcaption { margin-top: var(--space-sm); font-size: 0.9375rem; line-height: 1.45; color: var(--color-ink-2); }

  .sheet :global(.dg-wall) { fill: none; stroke: var(--color-ink); stroke-width: 3; }
  .sheet :global(.dg-thin) { fill: none; stroke: var(--color-ink); stroke-width: 1.5; }
  .sheet :global(.dg-line) { fill: none; stroke: var(--color-ink-2); stroke-width: 2.5; }
  .sheet :global(.dg-box) { fill: var(--color-paper); stroke: var(--color-ink); stroke-width: 1.5; }
  .sheet :global(.dg-solid) { fill: var(--color-ink-2); }
  .sheet :global(.dg-salt) { fill: #E4DEFF; }
  .sheet :global(.dg-water) { fill: #DCEBFF; stroke: var(--color-ink); stroke-width: 1.5; }
  .sheet :global(.dg-a) { fill: none; stroke: #1966FF; stroke-width: 3; }
  .sheet :global(.dg-b) { fill: none; stroke: #E8890C; stroke-width: 3; }
  .sheet :global(.dg-tbc) { fill: none; stroke: var(--color-muted); stroke-width: 2.5; stroke-dasharray: 7 6; }
  .sheet :global(.dg-bubble) { fill: var(--color-sheet); stroke: #1966FF; stroke-width: 1.5; }
  .sheet :global(text) { font-family: var(--font-display); font-weight: 600; font-size: 16px; fill: var(--color-ink); }
  .sheet :global(.dg-note) { font-family: var(--font-body); font-weight: 400; font-size: 14px; fill: var(--color-ink-2); }
  .sheet :global(.dg-muted) { fill: var(--color-muted); }
</style>
