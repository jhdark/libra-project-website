---
// One person: photo (when we have one), name, role, affiliation, what they
// did on LIBRA if they have moved on, and their public profile links.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LinkIcon from './LinkIcon.astro';
import { url } from '../lib/url';
import Tbc from './Tbc.astro';

export type PersonLinks = {
  email?: string;
  github?: string;
  linkedin?: string;
  scholar?: string;
  orcid?: string;
  psfc?: string;
  // Another institution's profile page (a university, UKAEA).
  profile?: string;
  website?: string;
};
export type Person = {
  name: string;
  role: string;
  affiliation: string;
  formerly?: string;
  photo?: string;
  links?: PersonLinks;
  // Older entries kept these at the top level.
  github?: string;
  email?: string;
};
interface Props {
  person: Person;
}
const { person: p } = Astro.props;

// Photos live in src/assets/people/ so Astro can resize them.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/people/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = p.photo ? photos[`../assets/people/${p.photo}`]?.default : undefined;

const l: PersonLinks = { ...p.links, github: p.links?.github ?? p.github, email: p.links?.email ?? p.email };
type Kind = 'psfc' | 'profile' | 'website' | 'scholar' | 'orcid' | 'github' | 'linkedin' | 'email';
const links = [
  l.psfc && { kind: 'psfc', label: 'MIT PSFC profile', href: l.psfc },
  l.profile && { kind: 'profile', label: 'Profile', href: l.profile },
  l.website && { kind: 'website', label: 'Website', href: l.website },
  l.scholar && { kind: 'scholar', label: 'Google Scholar', href: l.scholar },
  l.orcid && { kind: 'orcid', label: 'ORCID', href: `https://orcid.org/${l.orcid}` },
  l.github && { kind: 'github', label: 'GitHub', href: `https://github.com/${l.github}` },
  l.linkedin && { kind: 'linkedin', label: 'LinkedIn', href: l.linkedin },
  l.email && { kind: 'email', label: 'Email', href: `mailto:${l.email}` },
].filter(Boolean) as { kind: Kind; label: string; href: string }[];
// The PSFC site icon, used unaltered (greyscale until hover).
const psfcIcon = url('images/brand/psfc-icon-32.png');
---
<li class="person">
  {photo && (
    <Image src={photo} alt="" widths={[96, 192]} sizes="96px" class="photo" />
  )}
  <div>
    <h3>{p.name}</h3>
    {(p.role || !p.formerly) && <p class="role"><Tbc text={p.role || 'Role TBC'} /></p>}
    {p.affiliation && <p class="aff"><Tbc text={p.affiliation} /></p>}
    {p.formerly && <p class="formerly"><Tbc text={`Formerly ${p.formerly}`} /></p>}
    {links.length > 0 && (
      <ul class="links">
        {links.map((k) => (
          <li>
            <a class:list={['icon-link', k.kind]} href={k.href} target={k.kind === 'email' ? undefined : '_blank'} rel="noopener" aria-label={`${p.name}: ${k.label}`} title={k.label}>
              {k.kind === 'psfc' ? <img src={psfcIcon} alt="" width="18" height="18" loading="lazy" /> : <LinkIcon name={k.kind} />}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>

<style>
  .person { display: flex; gap: var(--space-md); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); break-inside: avoid; }
  .photo { width: 6rem; height: 6rem; object-fit: cover; flex-shrink: 0; background: var(--color-paper-2); outline: var(--rule-hair) solid var(--color-rule-2); outline-offset: -1px; }
  h3 { font-size: 1.25rem; line-height: 1.25; }
  .role { margin-top: var(--space-2xs); color: var(--color-ink-2); }
  .aff { font-size: 0.875rem; color: var(--color-muted); }
  .formerly { margin-top: var(--space-2xs); font-size: 0.875rem; color: var(--color-muted); }
  .links { list-style: none; margin: var(--space-xs) 0 0 calc(-1 * var(--space-3xs)); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  /* Small grey icons that take their own colour on hover or focus. */
  .icon-link { display: grid; place-items: center; width: 24px; height: 24px; padding: 3px; color: var(--color-muted); border-radius: var(--radius-control); transition: color var(--dur-micro) var(--ease-out); }
  .icon-link img { width: 18px; height: 18px; filter: grayscale(1); opacity: 0.7; transition: filter var(--dur-micro) var(--ease-out), opacity var(--dur-micro) var(--ease-out); }
  .icon-link:hover img, .icon-link:focus-visible img { filter: none; opacity: 1; }
  .icon-link:hover, .icon-link:focus-visible { color: var(--color-accent); }
  .github:hover, .github:focus-visible { color: var(--color-brand-github); }
  .linkedin:hover, .linkedin:focus-visible { color: var(--color-brand-linkedin); }
  .orcid:hover, .orcid:focus-visible { color: var(--color-brand-orcid); }
  .scholar:hover, .scholar:focus-visible { color: var(--color-brand-scholar); }

</style>
