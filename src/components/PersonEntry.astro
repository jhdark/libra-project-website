---
// One person, set in type: name, role, affiliation and links. A photo shows
// only when people.json gives one; there are no stand-in avatars.
import { url } from '../lib/url';

export type Person = { name: string; role: string; affiliation: string; photo?: string; github?: string; email?: string };
interface Props {
  person: Person;
}
const { person: p } = Astro.props;
---
<li class="person">
  {p.photo && <img src={url(p.photo)} alt="" width="96" height="96" />}
  <div>
    <h3>{p.name}</h3>
    <p class="role">{p.role || 'Role TBC'}</p>
    {p.affiliation && <p class="aff">{p.affiliation}</p>}
    {(p.github || p.email) && (
      <p class="links">
        {p.github && <a class="link" href={`https://github.com/${p.github}`} target="_blank" rel="noopener" aria-label={`${p.name} on GitHub`}>GitHub</a>}
        {p.email && <a class="link" href={`mailto:${p.email}`} aria-label={`Email ${p.name}`}>Email</a>}
      </p>
    )}
  </div>
</li>

<style>
  .person { display: flex; gap: var(--space-md); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  img { width: 4rem; height: 4rem; object-fit: cover; flex-shrink: 0; outline: var(--rule-hair) solid var(--color-rule-2); outline-offset: -1px; }
  h3 { font-size: 1.25rem; line-height: 1.25; }
  .role { margin-top: var(--space-2xs); color: var(--color-ink-2); }
  .aff { font-size: 0.875rem; color: var(--color-muted); }
  .links { margin-top: var(--space-xs); display: flex; gap: var(--space-md); font-size: 0.875rem; }
</style>
