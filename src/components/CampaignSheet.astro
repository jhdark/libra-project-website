---
// An experiment's campaigns set as a printed sheet: the table from its guide,
// the active campaign marked in Plasma Pink, and a few key facts beneath.
import type { CollectionEntry } from 'astro:content';
import Tbc from './Tbc.astro';
import type { CampaignTable } from '../lib/experiments';

interface Props {
  experiment: CollectionEntry<'experiments'>;
  campaigns: CampaignTable;
  factLabels?: string[];
}
const { experiment, campaigns, factLabels = ['Breeder volume', 'Neutron source', 'Tritium measurement'] } = Astro.props;
const { title, tagline, facts } = experiment.data;
const shownFacts = facts.filter((f) => factLabels.includes(f.label));
const statusCol = campaigns.headers.findIndex((h) => /status/i.test(h));
const numericCol = campaigns.headers.findIndex((h) => /runs/i.test(h));
const isActive = (row: string[]) => statusCol >= 0 && /active/i.test(row[statusCol] ?? '');
---
<figure class="sheet">
  <div class="cap">
    <h2>{title} campaigns</h2>
    <p><Tbc text={tagline} /></p>
  </div>
  <table>
    <thead>
      <tr>{campaigns.headers.map((h, i) => <th scope="col" class:list={{ num: i === numericCol }}>{h}</th>)}</tr>
    </thead>
    <tbody>
      {campaigns.rows.map((row) => (
        <tr class:list={{ marked: isActive(row) }}>
          {row.map((cell, i) =>
            i === 0 ? <th scope="row"><Tbc text={cell} /></th> : <td class:list={{ num: i === numericCol }}><Tbc text={cell} /></td>,
          )}
        </tr>
      ))}
    </tbody>
  </table>
  {shownFacts.length > 0 && (
    <dl>
      {shownFacts.map((f) => <div><dt>{f.label}</dt><dd><Tbc text={f.value} /></dd></div>)}
    </dl>
  )}
  <figcaption>From the {title} experiment guide.</figcaption>
</figure>

<style>
  .sheet { margin: 0; background: var(--color-sheet); border-top: var(--rule-bar) solid var(--color-rule-2); padding: var(--space-lg) var(--space-xl) var(--space-md); }
  .cap { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin-bottom: var(--space-md); }
  h2 { font-size: var(--text-title); }
  .cap p { font-size: 0.875rem; color: var(--color-muted); text-align: right; }
  table { width: 100%; }
  thead th { text-align: left; font-size: 0.875rem; font-weight: 400; color: var(--color-muted); padding: 0 var(--space-md) var(--space-xs) 0; border-bottom: var(--rule-bar) solid var(--color-rule-2); white-space: nowrap; }
  tbody th, td { text-align: left; padding: var(--space-sm) var(--space-md) var(--space-sm) 0; border-bottom: var(--rule-hair) solid var(--color-rule); vertical-align: baseline; }
  tbody th { font: 600 1rem/1.4 var(--font-display); color: var(--color-ink); white-space: nowrap; }
  .num { font-family: var(--font-mono); font-size: 0.9375rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .marked > * { background: var(--color-signal-wash); }
  .marked > :first-child { box-shadow: inset 4px 0 0 var(--color-signal); padding-left: var(--space-md); }
  dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); margin-top: var(--space-lg); }
  dt { font-size: 0.875rem; color: var(--color-muted); }
  dd { margin-top: var(--space-2xs); font-size: 0.9375rem; line-height: 1.4; }
  figcaption { margin-top: var(--space-md); font-size: 0.875rem; color: var(--color-muted); }
  @media (max-width: 60rem) { .sheet { padding-inline: var(--space-md); } }
  @media (max-width: 40rem) {
    .cap { flex-direction: column; gap: var(--space-2xs); }
    .cap p { text-align: left; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    table, tbody { display: block; }
    tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-md); row-gap: var(--space-2xs); align-items: baseline; padding: var(--space-sm) 0; border-bottom: var(--rule-hair) solid var(--color-rule); }
    tbody tr > * { padding: 0; border: 0; }
    tbody tr > :nth-child(2) { grid-column: 1; color: var(--color-ink-2); }
    tbody tr > :nth-child(3) { grid-column: 2; grid-row: 2; }
    tbody tr > :nth-child(4) { grid-column: 2; grid-row: 1; text-align: right; }
    tr.marked { background: var(--color-signal-wash); box-shadow: inset 4px 0 0 var(--color-signal); padding-inline: var(--space-md) var(--space-xs); }
    tr.marked > * { background: none; box-shadow: none; padding-left: 0; }
    dl { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
  }
</style>
