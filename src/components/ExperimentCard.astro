---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import { url } from '../lib/url';

interface Props {
  experiment: CollectionEntry<'experiments'>;
}
const { experiment } = Astro.props;
const { title, tagline, summary, status } = experiment.data;
---
<a href={url(`experiments/${experiment.id}`)}
   class="group flex flex-col rounded-2xl bg-surface p-7 ring-1 ring-line transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-accent/40">
  <div class="flex items-center justify-between">
    <Icon name="flask" class="h-7 w-7 text-accent" />
    <StatusBadge status={status} />
  </div>
  <h3 class="mt-5 font-display text-2xl font-bold">{title}</h3>
  <p class="font-body text-sm text-ink-faint">{tagline}</p>
  <p class="mt-3 flex-1 font-body text-sm leading-relaxed text-ink-muted">{summary}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 font-body text-sm font-semibold text-accent">
    Read the guide <Icon name="arrowRight" class="h-4 w-4 transition group-hover:translate-x-1" />
  </span>
</a>
