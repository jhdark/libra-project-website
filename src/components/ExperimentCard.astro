---
// One experiment as a full-width entry on the experiments index: key, name,
// tagline and status on the left; summary, key facts and the guide link on
// the right.
import type { CollectionEntry } from 'astro:content';
import ExperimentKey from './ExperimentKey.astro';
import StatusBadge from './StatusBadge.astro';
import Tbc from './Tbc.astro';
import { url } from '../lib/url';

interface Props {
  experiment: CollectionEntry<'experiments'>;
}
const { experiment } = Astro.props;
const { title, tagline, summary, status, order, facts } = experiment.data;
const href = url(`experiments/${experiment.id}`);
---
<article class="entry">
  <div class="name">
    <h2><ExperimentKey order={order} size="lg" /><a href={href}>{title}</a></h2>
    <p class="tagline"><Tbc text={tagline} /></p>
    <p class="state"><StatusBadge status={status} /></p>
  </div>
  <div class="body">
    <p class="summary">{summary}</p>
    {facts.length > 0 && (
      <dl>
        {facts.slice(0, 3).map((f) => <div><dt>{f.label}</dt><dd><Tbc text={f.value} /></dd></div>)}
      </dl>
    )}
    <p class="more"><a class="link-strong" href={href}>Read the {title} guide</a></p>
  </div>
</article>

<style>
  .entry { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); padding-block: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  h2 { display: flex; align-items: center; gap: var(--space-md); font-size: var(--text-section); }
  h2 a { color: var(--color-ink); text-decoration: none; }
  h2 a:hover { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; }
  .tagline { margin-top: var(--space-sm); color: var(--color-ink-2); padding-left: calc(2rem + var(--space-md)); }
  .state { margin-top: var(--space-xs); padding-left: calc(2rem + var(--space-md)); }
  .summary { font-size: var(--text-lead); line-height: 1.45; color: var(--color-ink-2); max-width: 60ch; }
  dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); margin-top: var(--space-lg); padding-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
  dt { font-size: 0.875rem; color: var(--color-muted); }
  dd { margin-top: var(--space-2xs); }
  .more { margin-top: var(--space-lg); }
  @media (max-width: 60rem) {
    .entry { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    dl { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
  }
</style>
