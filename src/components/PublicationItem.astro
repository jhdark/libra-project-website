---
import { linkHref, titleLink } from '../lib/url';
// One publication or talk as a citation: type and year, title, authors,
// venue, then its links. Example entries are flagged as such.
export interface Publication {
  type: string;
  title: string;
  authors: string;
  venue: string;
  year: number;
  experiments?: string[];
  links?: { label: string; href: string }[];
  placeholder?: boolean;
  featured?: boolean;
}
interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const { titleHref, others } = titleLink(pub.links);
const typeLabel = pub.type.charAt(0).toUpperCase() + pub.type.slice(1);
---
<article class="pub" data-type={pub.type}>
  <p class="meta">
    <span>{typeLabel}, <span class="num">{pub.year}</span></span>
    {pub.placeholder && <span class="example">Example entry</span>}
  </p>
  <div class="main">
    <h3>{titleHref ? <a class="title-link" href={titleHref} target="_blank" rel="noopener">{pub.title}</a> : pub.title}</h3>
    <p class="authors">{pub.authors}</p>
  </div>
  <div class="side">
    <p class="venue">{pub.venue}</p>
    {others.length > 0 && (
      <ul>
        {others.map((l) => (
          <li><a class="link-strong" href={linkHref(l.href)} target="_blank" rel="noopener">{l.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  /* Three columns across the page: type and year, title and authors, where
     it appeared and its links. */
  .pub { display: grid; grid-template-columns: 9rem minmax(0, 7fr) minmax(0, 4fr); gap: var(--gap-columns); padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .meta { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); font-size: 0.875rem; color: var(--color-muted); }
  .meta .num { font-size: 0.875rem; }
  /* A dashed outline marks a placeholder the team will replace. */
  .example { padding: 0 var(--space-xs); border: var(--rule-hair) dashed var(--color-muted); color: var(--color-ink-2); }
  h3 { font-size: var(--text-title); line-height: 1.2; max-width: 60ch; }
  .title-link { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .title-link:hover { color: var(--color-accent); }
  .authors { margin-top: var(--space-xs); color: var(--color-ink-2); max-width: 75ch; }
  .venue { font-size: 0.9375rem; font-style: italic; color: var(--color-ink-2); }
  ul { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-lg); }
  @media (max-width: 60rem) {
    .pub { grid-template-columns: 9rem minmax(0, 1fr); }
    .side { grid-column: 2; }
  }
  @media (max-width: 40rem) {
    .pub { grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); }
    .side { grid-column: 1; }
    .meta { flex-direction: row; gap: var(--space-md); }
  }
</style>
