---
// News posts as dated rows under a firm rule.
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/url';
import Tbc from './Tbc.astro';

interface Props {
  posts: CollectionEntry<'news'>[];
  headingLevel?: 'h2' | 'h3';
  // Full page width: date, title and summary side by side.
  wide?: boolean;
}
const { posts, headingLevel = 'h3', wide = false } = Astro.props;
const Heading = headingLevel;
---
<ol class:list={['news-list', { wide }]}>
  {posts.map((n) => (
    <li>
      <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
      <div>
        <Heading><a href={url(`news/${n.id}`)}>{n.data.title}</a></Heading>
        <p><Tbc text={n.data.summary} /></p>
      </div>
    </li>
  ))}
</ol>

<style>
  .news-list { list-style: none; margin: 0; padding: 0; border-top: var(--rule-bar) solid var(--color-rule-2); }
  li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--gap-columns); padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); }
  time { font-size: 0.875rem; line-height: 1.9; color: var(--color-muted); }
  h2, h3 { font-size: var(--text-title); line-height: 1.2; }
  a { color: var(--color-ink); text-decoration: none; }
  a:hover { color: var(--color-accent); text-decoration: underline; }
  p { margin-top: var(--space-xs); color: var(--color-ink-2); max-width: 65ch; }
  .wide li { grid-template-columns: 11rem minmax(0, 5fr) minmax(0, 6fr); align-items: baseline; }
  .wide li > div { display: contents; }
  .wide p { margin-top: 0; }
  @media (max-width: 60rem) {
    .wide li { grid-template-columns: 11rem minmax(0, 1fr); }
    .wide li > div { display: block; }
    .wide p { margin-top: var(--space-xs); }
  }
  @media (max-width: 40rem) { li, .wide li { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); } }
</style>
