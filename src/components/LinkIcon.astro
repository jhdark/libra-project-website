---
// Small monochrome icons for profile links. Brand marks (GitHub, ORCID,
// Google Scholar) are from Simple Icons (CC0); LinkedIn is a plain "in"
// square drawn here; mail, website and profile are simple line icons.
// Icons take currentColor, so the parent sets their colour.
interface Props {
  name: 'github' | 'orcid' | 'scholar' | 'linkedin' | 'email' | 'website' | 'profile';
}
const { name } = Astro.props;
