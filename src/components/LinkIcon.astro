---
{filled[name] ? (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="icon"><path fill-rule="evenodd" d={filled[name]} /></svg>
) : (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon" set:html={stroked[name]} />
)}

<style>
  .icon { width: 100%; height: 100%; display: block; }
</style>
