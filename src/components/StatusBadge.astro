---
// Status as type, not a pill: active in the display face, completed in ink,
// planned muted.
interface Props {
  status: 'completed' | 'active' | 'planned';
}
const { status } = Astro.props;
const label = { active: 'Active', completed: 'Completed', planned: 'Planned' }[status];
---
<span class:list={['status', status]}>{label}</span>

<style>
  .status { white-space: nowrap; }
  .active { font: 600 1rem/1.5 var(--font-display); color: var(--color-ink); }
  .completed { color: var(--color-ink-2); }
  .planned { color: var(--color-muted); }
</style>
