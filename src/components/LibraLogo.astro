---
// Typographic wordmark until the project has a logo (TBC). A combined
// MIT/PSFC lockup for LIBRA can only come from PSFC communications, so the
// PSFC lockup appears separately, unaltered, in the footer.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<span class:list={['wordmark', className]}>
  <b>LIBRA</b>
  <span>MIT Plasma Science and Fusion Center</span>
</span>

<style>
  .wordmark { display: grid; justify-items: center; gap: var(--space-2xs); color: var(--color-ink); }
  b { font: 600 2.25rem/1 var(--font-display); letter-spacing: 0.06em; }
  span span { font-size: 0.875rem; color: var(--color-muted); }
  @media (max-width: 60rem) {
    .wordmark { justify-items: start; }
    b { font-size: 1.75rem; }
  }
</style>
