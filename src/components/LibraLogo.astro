---
// Typographic wordmark until the project has a logo (TBC). A combined
// MIT/PSFC lockup for LIBRA can only come from PSFC communications, so the
// centre is named beneath the wordmark in type.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<span class:list={['wordmark', className]}>
  <b>LIBRA</b>
  <span>MIT Plasma Science and Fusion Center</span>
</span>

<style>
  .wordmark { display: grid; justify-items: start; gap: var(--space-2xs); color: var(--color-ink); }
  b { font: 600 1.75rem/1 var(--font-display); letter-spacing: 0.06em; }
  span span { font-size: 0.875rem; color: var(--color-muted); }
</style>
