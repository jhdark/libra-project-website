---
const { src, alt = "3D model", poster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<model-viewer
  src={`${base}/${src}`}
  alt={alt}
  poster={poster && `${base}/${poster}`}
  camera-controls
  auto-rotate
  shadow-intensity="1"
  style="width:100%; height:480px; background:#f4f4f4; border-radius:8px;"
></model-viewer>

<script>
  import "@google/model-viewer";
</script>