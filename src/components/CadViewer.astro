---
const { src, alt = "3D model", poster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<figure class="cad">
  <model-viewer
    src={`${base}/${src}`}
    alt={alt}
    poster={poster && `${base}/${poster}`}
    camera-controls
    auto-rotate
    shadow-intensity="1"
  ></model-viewer>
  <figcaption>Drag to rotate, scroll or pinch to zoom.</figcaption>
</figure>

<script>
  import "@google/model-viewer";
  // Respect a reduced-motion preference: no turntable rotation.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("model-viewer[auto-rotate]").forEach((el) => el.removeAttribute("auto-rotate"));
  }
</script>

<style>
  .cad { margin: var(--space-lg) 0; border: var(--rule-hair) solid var(--color-rule); background: var(--color-paper-2); }
  model-viewer { display: block; width: 100%; height: 480px; background: var(--color-paper-2); }
  model-viewer:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  figcaption { margin: 0; padding: var(--space-xs) var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); font-size: 0.875rem; color: var(--color-muted); background: var(--color-sheet); }
</style>
