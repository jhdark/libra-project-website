---
// The scale-up path: every experiment with a `stage` in its frontmatter, in
// order, with its render, breeder volume and status, over a bar in the
// experiment key colours. Render heights follow the log of the volume, so
// 0.1 L to 700 L reads as a climb without the smallest vanishing.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ExperimentKey from './ExperimentKey.astro';
import StatusBadge from './StatusBadge.astro';
import { keyColour } from '../lib/experiments';
import { url } from '../lib/url';

interface Props {
  experiments: CollectionEntry<'experiments'>[];
}
const stages = Astro.props.experiments
  .filter((e) => e.data.stage)
  .sort((a, b) => a.data.order - b.data.order);

const logs = stages.map((e) => Math.log10(e.data.stage!.volume));
const [lo, hi] = [Math.min(...logs), Math.max(...logs)];
const height = (volume: number) => 30 + (70 * (Math.log10(volume) - lo)) / (hi - lo || 1);
const litres = (volume: number) => `${volume.toLocaleString('en-GB')} L`;
const bar = `linear-gradient(to right, ${stages.map((e) => keyColour(e.data.order)).join(', ')})`;
---
<ol class="roadmap" style={`--bar: ${bar}`}>
  {stages.map((e) => {
    const { title, order, status, stage } = e.data;
    return (
      <li style={`--k: ${keyColour(order)}`}>
        <a href={url(`experiments/${e.id}`)}>
          <div class="render">
            <Image
              src={stage!.image}
              alt={`Render of ${title}`}
              widths={[160, 320, 480]}
              sizes="(min-width: 60rem) 15vw, 40vw"
              style={`height: ${height(stage!.volume).toFixed(1)}%`}
            />
          </div>
          <span class="tick" aria-hidden="true"></span>
          <span class="volume num">{litres(stage!.volume)}</span>
          <span class="name"><ExperimentKey order={order} />{title}</span>
          <StatusBadge status={status} />
        </a>
      </li>
    );
  })}
</ol>

<style>
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0 var(--gap-columns); position: relative; }
  /* The bar runs under all the renders, in the experiments' key colours. */
  .roadmap::after { content: ''; position: absolute; left: 0; right: 0; top: calc(var(--render-h) + var(--space-md)); height: 10px; background: var(--bar); outline: var(--rule-hair) solid var(--color-ink); outline-offset: -1px; }
  .roadmap { --render-h: 18rem; }
  a { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); color: var(--color-ink); text-decoration: none; }
  .render { height: var(--render-h); width: 100%; display: flex; align-items: flex-end; justify-content: center; }
  .render img { width: auto; max-width: 100%; object-fit: contain; transition: transform var(--dur-micro) var(--ease-out); }
  a:hover .render img { transform: translateY(-4px); }
  .tick { position: relative; z-index: 1; align-self: center; width: 2px; height: calc(10px + 2 * var(--space-md)); background: var(--color-ink); margin-bottom: var(--space-xs); }
  .volume { font-size: var(--text-title); line-height: 1.2; }
  .name { display: inline-flex; align-items: center; gap: var(--space-xs); font: 600 1.125rem/1.3 var(--font-display); }
  a:hover .name { color: var(--color-accent); text-decoration: underline; }

  @media (max-width: 48rem) {
    .roadmap { --render-h: 11rem; grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl) var(--gap-columns); }
    .roadmap::after { display: none; }
    .tick { display: none; }
    li { border-top: 6px solid var(--k); padding-top: var(--space-sm); }
  }
</style>
