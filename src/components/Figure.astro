---
// One photo or drawing from src/data/media.json, with its caption, date and
// credit beneath. Drawings are shown whole on the sheet colour; photos fill
// their frame.
import { Image } from 'astro:assets';
import type { Photo } from '../lib/media';
import { formatMonth } from '../lib/media';
import Tbc from './Tbc.astro';

interface Props {
  photo: Photo;
  sizes?: string;
  ratio?: string;
}
const { photo: p, sizes = '(min-width: 60rem) 33vw, 100vw', ratio = '4 / 3' } = Astro.props;
---
<figure class:list={['figure', p.kind]} style={`--ratio: ${ratio}`}>
  <div class="frame">
    <Image src={p.image} alt={p.alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading="lazy" />
  </div>
  <figcaption>
    <Tbc text={p.caption} />
    <span class="meta"><Tbc text={[formatMonth(p.date), p.credit].filter(Boolean).join(', ')} /></span>
  </figcaption>
</figure>

<style>
  .figure { margin: 0; min-width: 0; }
  .frame { aspect-ratio: var(--ratio); overflow: hidden; background: var(--color-paper-2); outline: var(--rule-hair) solid var(--color-rule); outline-offset: -1px; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .drawing .frame { background: var(--color-sheet); }
  .drawing img { object-fit: contain; padding: var(--space-md); }
  figcaption { margin-top: var(--space-sm); font-size: 0.9375rem; line-height: 1.45; color: var(--color-ink-2); }
  .meta { display: block; margin-top: var(--space-2xs); font-size: 0.875rem; color: var(--color-muted); }
</style>
