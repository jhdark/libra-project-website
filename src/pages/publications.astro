---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import publications from '../data/publications.json';

const items = [...publications.items].sort((a, b) => b.year - a.year);
const filters = [
  { key: 'all', label: 'All' },
  { key: 'article', label: 'Articles' },
  { key: 'preprint', label: 'Preprints' },
  { key: 'talk', label: 'Talks' },
  { key: 'poster', label: 'Posters' },
  { key: 'thesis', label: 'Theses' },
];
---

<Base title="Publications">
  <PageHeader
    title="Papers, talks and posters"
    intro="Journal articles, preprints, conference presentations and theses from the LIBRA project."
  />

  <section class="pubs">
    <div class="wrap">
      <div class="filters" role="toolbar" aria-label="Filter by type">
        {filters.map((f) => (
          <button type="button" data-filter={f.key} class="pub-filter"
                  aria-pressed={f.key === 'all' ? 'true' : 'false'}>
            {f.label}
          </button>
        ))}
      </div>
      <div id="pub-list" class="list">
        {items.map((p) => <PublicationItem pub={p} />)}
      </div>
      <p id="pub-empty" class="empty hidden">Nothing of this type yet.</p>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  const items = document.querySelectorAll<HTMLElement>('#pub-list [data-type]');
  const empty = document.getElementById('pub-empty');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((el) => {
        const match = key === 'all' || el.dataset.type === key;
        el.hidden = !match;
        if (match) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    }),
  );
</script>

<style>
  .pubs { padding-block: var(--space-2xl) var(--section-gap); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .pub-filter { min-height: 44px; padding-inline: var(--space-md); border: var(--rule-hair) solid var(--color-ink); border-radius: var(--radius-control); background: transparent; color: var(--color-ink); font: 600 0.9375rem/1 var(--font-display); cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .pub-filter:hover { background: var(--color-paper-2); }
  .pub-filter:active { background: var(--color-paper-3); }
  .pub-filter[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .list { margin-top: var(--space-xl); border-top: var(--rule-bar) solid var(--color-rule-2); }
  .empty { margin-top: var(--space-xl); color: var(--color-muted); }
</style>
