---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import datasets from '../data/datasets.json';
import { url } from '../lib/url';

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
const titleOf = (slug: string) => experiments.find((e) => e.id === slug)?.data.title ?? 'Project-wide';

const hubs = [
  {
    icon: 'database',
    title: 'Zenodo community',
    body: 'Archived datasets, software releases and publications, each with a citable DOI.',
    href: datasets.zenodoCommunity,
  },
  {
    icon: 'github',
    title: 'GitHub organisation',
    body: 'One repository per experimental run with raw data, analysis notebooks and models.',
    href: 'https://github.com/LIBRA-project',
  },
  {
    icon: 'book',
    title: 'libra-toolbox',
    body: 'Our Python package for neutron detection and tritium analysis, with full documentation.',
    href: 'https://libra-toolbox.readthedocs.io/en/latest/',
  },
];
---

<Base title="Data & Code">
  <PageHeader
    eyebrow="Data & Code"
    title="Open data and software"
    intro="Everything needed to reproduce LIBRA results: measurements, analysis and models."
  />

  <section class="py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-6 md:grid-cols-3">
        {hubs.map((h) => (
          <a href={h.href} target="_blank" rel="noopener" class="group rounded-2xl bg-surface p-7 ring-1 ring-line transition hover:ring-accent/40">
            <Icon name={h.icon} class="h-8 w-8 text-accent" />
            <h2 class="mt-4 flex items-center gap-2 font-display text-xl font-semibold">
              {h.title} <Icon name="external" class="h-4 w-4 text-ink-faint" />
            </h2>
            <p class="mt-2 font-body text-sm text-ink-muted">{h.body}</p>
          </a>
        ))}
      </div>

      <div class="mt-16 rounded-2xl bg-surface p-8 ring-1 ring-line">
        <h2 class="font-display text-2xl font-bold">How run data is organised</h2>
        <p class="mt-3 max-w-3xl font-body text-ink-muted">
          Each run lives in its own repository created from a shared template, with raw data under
          <code class="font-mono text-sm">data/</code> and analysis under <code class="font-mono text-sm">analysis/</code>.
          Releases are archived on Zenodo automatically. Most repositories can be run in the browser with Binder.
          See the <a href={url('experiments/baby')} class="text-accent-hover underline-offset-4 hover:underline">BABY guide</a> for details.
        </p>
      </div>

      <h2 class="mt-16 font-display text-2xl font-bold">Zenodo records</h2>
      <p class="mt-1 font-body text-sm text-ink-faint">Maintained by hand in src/data/datasets.json for now.</p>
      <div class="mt-6 overflow-x-auto rounded-xl bg-surface ring-1 ring-line">
        <table class="w-full min-w-[40rem] text-left font-body text-sm">
          <thead class="border-b border-line text-xs uppercase tracking-wider text-ink-faint">
            <tr>
              <th class="px-5 py-3 font-medium">Record</th>
              <th class="px-5 py-3 font-medium">Experiment</th>
              <th class="px-5 py-3 font-medium">Type</th>
              <th class="px-5 py-3 font-medium">Date</th>
              <th class="px-5 py-3 font-medium">DOI</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {datasets.items.map((d) => (
              <tr>
                <td class="px-5 py-3">{d.title}</td>
                <td class="px-5 py-3 text-ink-muted">{titleOf(d.experiment)}</td>
                <td class="px-5 py-3 capitalize text-ink-muted">{d.kind}</td>
                <td class="whitespace-nowrap px-5 py-3 text-ink-muted">{d.date}</td>
                <td class="px-5 py-3">
                  <a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener" class="font-mono text-xs text-accent-hover hover:underline">{d.doi}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
