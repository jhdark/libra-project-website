---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ExperimentKey from '../components/ExperimentKey.astro';
import datasets from '../data/datasets.json';
import { url } from '../lib/url';

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
const experimentOf = (slug: string) => experiments.find((e) => e.id === slug);
const titleOf = (slug: string) => experimentOf(slug)?.data.title ?? 'Project-wide';

const hubs = [
  {
    title: 'Zenodo community',
    body: 'Archived datasets, software releases and publications, each with a citable DOI.',
    href: datasets.zenodoCommunity,
  },
  {
    title: 'GitHub organisation',
    body: 'One repository per experimental run with raw data, analysis notebooks and models.',
    href: 'https://github.com/LIBRA-project',
  },
  {
    title: 'libra-toolbox',
    body: 'Our Python package for neutron detection and tritium analysis, with full documentation.',
    href: 'https://libra-toolbox.readthedocs.io/en/latest/',
  },
];
---

<Base title="Data & Code">
  <PageHeader
    title="Open data and software"
    intro="Everything needed to reproduce LIBRA results: measurements, analysis and models."
  />

  <section class="hubs">
    <div class="wrap">
      <ul>
        {hubs.map((h) => (
          <li>
            <h2><a href={h.href} target="_blank" rel="noopener">{h.title}</a></h2>
            <p>{h.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="organised">
    <div class="wrap">
      <h2>How run data is organised</h2>
      <p>
        Each run lives in its own repository created from a shared template,
        with raw data under <code>data/</code> and analysis under <code>analysis/</code>.
        Each GitHub release is archived on Zenodo automatically; so far BABY 1 L runs 1 to 4 and FLiBe
        runs 1 and 2 have releases. BABY 1 L runs 1 to 4 and 6 can be run in the browser with Binder.
        See the <a class="link" href={url('experiments/baby-1l')}>BABY 1 L guide</a> for details.
      </p>
    </div>
  </section>

  <section class="records-section">
    <div class="wrap">
      <div class="split-head">
        <h2>Zenodo records</h2>
        <p class="note">Maintained by hand in src/data/datasets.json for now.</p>
      </div>
      <table class="records">
        <thead>
          <tr>
            <th scope="col">Record</th>
            <th scope="col">Experiment</th>
            <th scope="col">Type</th>
            <th scope="col">Date</th>
            <th scope="col">DOI</th>
          </tr>
        </thead>
        <tbody>
          {datasets.items.map((d) => {
            const e = experimentOf(d.experiment);
            return (
              <tr>
                <th scope="row">{d.title}</th>
                <td class="exp">{e && <ExperimentKey order={e.data.order} />}{titleOf(d.experiment)}</td>
                <td class="kind">{d.kind}</td>
                <td class="num">{d.date}</td>
                <td class="num"><a class="link" href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">{d.doi}</a></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  /* The three places the data and code live, as ruled rows. */
  .hubs { padding-block: var(--space-2xl) 0; }
  .hubs ul { list-style: none; margin: 0; padding: 0; border-top: var(--rule-bar) solid var(--color-rule-2); }
  .hubs li { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); align-items: baseline; padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .hubs h2 { font-size: var(--text-title); line-height: 1.2; }
  .hubs h2 a { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .hubs h2 a:hover { color: var(--color-accent-2); }
  .hubs p { color: var(--color-ink-2); max-width: 60ch; }
  @media (max-width: 40rem) { .hubs li { grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); } }

  .organised { padding-block: var(--space-3xl); }
  .organised .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); }
  .organised h2 { font-size: var(--text-section); }
  .organised p { font-size: var(--text-lead); line-height: 1.5; color: var(--color-ink-2); max-width: 60ch; }
  .organised code { font-family: var(--font-mono); font-size: 0.9em; color: var(--color-ink); }
  @media (max-width: 60rem) { .organised .wrap { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); } }

  .records-section { background: var(--color-paper-2); padding-block: var(--section-gap-s); }
  .note { color: var(--color-muted); }
  .records { width: 100%; }
  .records thead th { text-align: left; font-size: 0.875rem; font-weight: 400; color: var(--color-muted); padding: 0 var(--space-md) var(--space-xs) 0; border-bottom: var(--rule-bar) solid var(--color-rule-2); white-space: nowrap; }
  .records tbody th, .records td { text-align: left; font-weight: 400; padding: var(--space-sm) var(--space-md) var(--space-sm) 0; border-bottom: var(--rule-hair) solid var(--color-rule); vertical-align: baseline; }
  .records tbody th { color: var(--color-ink); }
  .exp { display: flex; gap: var(--space-xs); align-items: baseline; white-space: nowrap; color: var(--color-ink-2); }
  .exp :global(.key) { align-self: center; }
  .kind { color: var(--color-ink-2); }
  .kind::first-letter { text-transform: uppercase; }
  .records .num { font-size: 0.875rem; white-space: nowrap; }
  @media (max-width: 60rem) {
    .records thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .records, .records tbody { display: block; }
    .records tr { display: grid; grid-template-columns: auto auto minmax(0, 1fr); column-gap: var(--space-md); row-gap: var(--space-2xs); padding-block: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule); }
    .records tbody th, .records td { padding: 0; border: 0; }
    .records tbody th { grid-column: 1 / -1; }
    .records td.num:last-child { grid-column: 1 / -1; }
  }
</style>
