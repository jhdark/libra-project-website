---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <PageHeader title="Page not found" intro="That page does not exist, or it has moved.">
    <p class="back"><a href={url()} class="btn btn-primary">Back to the homepage</a></p>
  </PageHeader>
</Base>

<style>
  .back { margin-top: var(--space-xl); }
</style>
