---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import CampaignSheet from '../components/CampaignSheet.astro';
import Tbc from '../components/Tbc.astro';
import ExperimentLedger from '../components/ExperimentLedger.astro';
import NewsList from '../components/NewsList.astro';
import publications from '../data/publications.json';
import datasets from '../data/datasets.json';
import { url, linkHref, titleLink } from '../lib/url';
import { campaignsOf } from '../lib/experiments';

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const featured = publications.items.filter((p) => 'featured' in p && p.featured);
const latestRecords = [...datasets.items].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);

// The hero sheet shows the first active experiment whose guide has a
// Campaigns table (BABY today).
const lead = experiments.find((e) => e.data.status === 'active' && campaignsOf(e)) ?? null;
const leadCampaigns = lead ? campaignsOf(lead) : null;

const pillars = [
  {
    title: 'Tritium breeding',
    body: 'Fusion power plants must breed their own tritium. LIBRA irradiates lithium-bearing breeders with DT fusion neutrons to measure how much tritium they actually produce.',
  },
  {
    title: 'Accountancy and diagnostics',
    body: 'Neutron diagnostics and tritium measurements, from activation foils to liquid scintillation counting, close the loop between what is bred and what is recovered.',
  },
  {
    title: 'Open science',
    body: 'Every run has a public repository with its data and analysis, built on our open-source libra-toolbox, and each release is archived on Zenodo with a DOI.',
  },
];
---

<Base>
  <HeroVideo
    title="Breeding tritium for fusion energy"
    lead="Experiments measuring tritium breeding for fusion blankets, in molten salts today and lead-lithium and lithium oxide next."
    caption="<mark>In the lab: the tritium bubbler, a sweep gas panel, bubbler sample vials, FLiNaK salt being dispensed and salt being poured.</mark>"
  />

  <!-- The lead experiment's campaigns -->
  <section class="record">
    <div class="wrap">
      <div>
        <h2>The latest campaigns</h2>
        <p class="lead">Each BABY run irradiates a breeder with DT fusion neutrons and counts the tritium it releases.</p>
      </div>
      {lead && leadCampaigns && <CampaignSheet experiment={lead} campaigns={leadCampaigns} />}
    </div>
  </section>

  <!-- About -->
  <section id="about" class="about">
    <div class="wrap">
      <div>
        <h2>Closing the fuel cycle</h2>
        <p class="lead">
          LIBRA (Liquid Immersion Blanket: Robust Accountancy) is a series of experiments
          demonstrating and measuring tritium breeding, in molten salts and, soon, other breeders.
        </p>
        <p class="mission">
          The project addresses the open questions of the liquid immersion blanket, a tank of molten
          salt around a fusion plasma that breeds tritium, cools the vacuum vessel and shields
          neutrons in one. The experiments grow in stages, from 0.1 L of salt in BABY to
          <mark>700 L in LIBRA-One</mark>, towards the project's long-term goal: a tritium breeding
          ratio of at least one, breeding more tritium than the neutron source consumes.
          Beyond molten salts, BABY 1 L runs with lead-lithium and lithium oxide are in
          preparation.
        </p>
        <p class="mission">
          LIBRA is funded by ARPA-E (<mark>OPEN 2021, </mark>award DE-AR0001542)<mark> and works
          with partners including Commonwealth Fusion Systems and Idaho National Laboratory</mark>.
        </p>
      </div>
      <ol class="pillars">
        {pillars.map((p) => (
          <li><h3>{p.title}</h3><p>{p.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Experiments -->
  <section class="experiments">
    <div class="wrap">
      <div class="split-head">
        <h2>Under the LIBRA umbrella</h2>
        <p class="head-link"><a class="link-strong" href={url('experiments')}>All experiments</a></p>
      </div>
      <ExperimentLedger experiments={experiments} />
    </div>
  </section>

  <!-- Featured publication, set as a statement -->
  {featured.map((p) => { const { titleHref, others } = titleLink(p.links); return (
    <section class="paper" aria-labelledby="featured-paper">
      <div class="wrap">
        <div class="split-head">
          <h2 id="featured-paper">Featured publication</h2>
          <p class="head-link"><a class="link-strong" href={url('publications')}>All publications and talks</a></p>
        </div>
        <p class="paper-type">{p.type.charAt(0).toUpperCase() + p.type.slice(1)}, <span class="num">{p.year}</span></p>
        <h3 class="statement">{titleHref ? <a class="title-link" href={titleHref} target="_blank" rel="noopener"><Tbc text={p.title} /></a> : <Tbc text={p.title} />}</h3>
        <div class="paper-meta">
          <div>
            <p class="authors"><Tbc text={p.authors} /></p>
            <p class="venue"><Tbc text={p.venue} /></p>
          </div>
          <ul class="paper-links">
            {others.map((l) => <li><a class="link-strong" href={linkHref(l.href)} target="_blank" rel="noopener">{l.label}</a></li>)}
          </ul>
        </div>
      </div>
    </section>
  ); })}

  <!-- Open data -->
  <section class="data">
    <div class="wrap">
      <div class="split-head">
        <h2>All our data is open</h2>
        <div>
          <p class="lead">Raw measurements, analysis notebooks and simulation models for every run, with DOIs for citation.</p>
          <div class="actions">
            <a class="btn btn-on-ink" href={datasets.zenodoCommunity} target="_blank" rel="noopener">Zenodo</a>
            <a class="btn btn-on-ink" href="https://github.com/LIBRA-project" target="_blank" rel="noopener">GitHub</a>
          </div>
        </div>
      </div>
      <table class="records">
        <caption>The latest {latestRecords.length} of {datasets.items.length} records in the LIBRA Zenodo community</caption>
        <thead><tr><th scope="col">Record</th><th scope="col">Published</th><th scope="col">DOI</th></tr></thead>
        <tbody>
          {latestRecords.map((d) => (
            <tr>
              <th scope="row">{d.title}</th>
              <td class="num">{d.date}</td>
              <td class="num"><a href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">{d.doi}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- News -->
  <section class="news">
    <div class="wrap">
      <div>
        <h2>Latest news</h2>
        <p class="news-link"><a class="link-strong" href={url('news')}>All news</a></p>
      </div>
      <NewsList posts={news} />
    </div>
  </section>
</Base>

<style>
  .record { padding-block: var(--section-gap-s); }
  .record .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); align-items: center; }
  .record h2 { font-size: var(--text-section); }
  .record .lead { margin-top: var(--space-lg); }
  @media (max-width: 60rem) { .record .wrap { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; }

  /* About: head beside numbered rows. */
  .about { padding-block: var(--section-gap-l) var(--section-gap); }
  .about .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); align-items: start; }
  .about h2 { font-size: var(--text-section); }
  .about .lead { margin-top: var(--space-lg); }
  .mission { margin-top: var(--space-md); color: var(--color-ink-2); max-width: 56ch; }
  .pillars { list-style: none; margin: 0; padding: 0; counter-reset: pillar; border-top: var(--rule-bar) solid var(--color-rule-2); }
  .pillars li { counter-increment: pillar; display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: var(--space-md); padding-block: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .pillars li::before { content: counter(pillar); grid-row: span 2; font: 400 var(--text-title)/1.2 var(--font-mono); color: var(--color-muted); }
  .pillars h3 { font-size: var(--text-title); line-height: 1.2; }
  .pillars p { margin-top: var(--space-xs); color: var(--color-ink-2); }
  @media (max-width: 60rem) { .about .wrap { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); } }

  /* Experiments: a band of the second paper. */
  .experiments { background: var(--color-paper-2); padding-block: var(--section-gap-s); }

  /* Featured paper: the title as a statement. */
  .paper { padding-block: var(--section-gap) var(--section-gap-s); }
  .paper-type { margin-bottom: var(--space-sm); color: var(--color-muted); }
  .paper-type .num { font-size: 0.9375rem; }
  .title-link { color: inherit; text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 3px; text-underline-offset: 0.15em; }
  .title-link:hover { color: var(--color-accent); }
  .statement { font-size: var(--text-display-s); line-height: 1.08; letter-spacing: -0.02em; max-width: 34ch; }
  .paper-meta { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap-columns); margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .authors { color: var(--color-ink-2); max-width: 70ch; }
  .venue { margin-top: var(--space-sm); font-size: 0.875rem; font-style: italic; color: var(--color-muted); }
  .paper-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); align-content: start; }
  @media (max-width: 60rem) { .paper-meta { grid-template-columns: minmax(0, 1fr); } }

  /* Open data: the ink band. */
  .data { background: var(--color-band); color: var(--color-on-ink); padding-block: var(--section-gap-s); --color-focus: var(--color-on-ink-link); }
  .data .split-head { border-bottom-color: var(--color-on-ink); }
  .data .lead { color: var(--color-on-ink-2); }
  .data .actions { margin-top: var(--space-lg); }
  .records { width: 100%; }
  .records caption { caption-side: bottom; text-align: left; padding-top: var(--space-md); font-size: 0.875rem; color: var(--color-on-ink-2); }
  .records thead th { text-align: left; font-size: 0.875rem; font-weight: 400; color: var(--color-on-ink-2); padding: 0 var(--space-md) var(--space-xs) 0; border-bottom: var(--rule-bar) solid var(--color-on-ink); }
  .records tbody th, .records td { text-align: left; font-weight: 400; padding: var(--space-md) var(--space-md) var(--space-md) 0; border-bottom: var(--rule-hair) solid var(--color-on-ink-rule); vertical-align: baseline; }
  .records .num { font-size: 0.9375rem; white-space: nowrap; }
  .records a { color: var(--color-on-ink-link); }
  @media (max-width: 40rem) {
    .records thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .records, .records tbody, .records tr, .records tbody th, .records td { display: block; }
    .records caption { display: block; caption-side: top; padding: 0 0 var(--space-sm); }
    .records tr { padding-block: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-on-ink-rule); }
    .records tbody th, .records td { padding: 0; border: 0; }
    .records td { margin-top: var(--space-2xs); }
  }

  /* News: head beside dated rows. */
  .news { padding-block: var(--section-gap) var(--section-gap-l); }
  .news .wrap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gap-columns); align-items: start; }
  .news h2 { font-size: var(--text-section); }
  .news-link { margin-top: var(--space-md); }
  @media (max-width: 60rem) { .news .wrap { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
