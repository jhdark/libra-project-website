---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Experiments">
  <PageHeader
    title="The LIBRA experiments"
    intro="Each experiment has a detailed guide covering its setup, diagnostics, how to run it, and where to find its data and analysis."
  />
  <section class="list">
    <div class="wrap">
      {experiments.map((e) => <ExperimentCard experiment={e} />)}
    </div>
  </section>
</Base>

<style>
  .list { padding-block: var(--space-xl) var(--section-gap); }
</style>
