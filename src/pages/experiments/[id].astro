---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ExperimentKey from '../../components/ExperimentKey.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import Tbc from '../../components/Tbc.astro';
import publications from '../../data/publications.json';
import datasets from '../../data/datasets.json';
import CadViewer from '../../components/CadViewer.astro';
import Diagram from '../../components/Diagram.astro';
import { keyColour, plainText } from '../../lib/experiments';
import Figure from '../../components/Figure.astro';
import { photosFor } from '../../lib/media';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((experiment) => ({ params: { id: experiment.id }, props: { experiment } }));
}

interface Props {
  experiment: CollectionEntry<'experiments'>;
}
const { experiment } = Astro.props;
const { title, tagline, summary, status, order, facts, repos, needsReview, stage } = experiment.data;
const { Content, headings } = await render(experiment);
const toc = headings.filter((h) => h.depth === 2);

const relatedPubs = publications.items.filter((p) => p.experiments?.includes(experiment.id));
const relatedData = datasets.items.filter((d) => d.experiment === experiment.id);
const gallery = photosFor(experiment.id);
---

<Base title={title} description={plainText(summary)} note={needsReview ? `This guide is a draft and has not yet been reviewed by the ${title} team.` : undefined}>
  <div class="identity" style={`--k: ${keyColour(order)}`}>
    <PageHeader title={title} intro={summary}>
      <p class="meta">
        <ExperimentKey order={order} size="lg" />
        <span class="tagline"><Tbc text={tagline} /></span>
        <StatusBadge status={status} />
      </p>
      {stage && (
        <Image slot="figure" src={stage.image} alt={`Render of ${title}`} widths={[240, 480, 720]} sizes="18rem" loading="eager" />
      )}
    </PageHeader>
  </div>

  <div class="wrap guide">
    {toc.length > 0 && (
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title">On this page</h2>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <article class="prose prose-libra max-w-none">
      <Content components={{ CadViewer, Diagram }} />
    </article>

    {facts.length > 0 && (
      <aside class="facts" aria-labelledby="facts-title">
        <h2 id="facts-title">Key facts</h2>
        <dl>
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd><Tbc text={f.value} /></dd>
            </div>
          ))}
        </dl>
      </aside>
    )}
  </div>

  <!-- Photos and drawings tagged with this experiment in src/data/media.json -->
  {gallery.length > 0 && (
    <section class="lab" aria-labelledby="lab-title">
      <div class="wrap">
        <div class="split-head"><h2 id="lab-title">In the lab</h2></div>
        <div class="gallery">
          {gallery.map((p) => <Figure photo={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Repositories, datasets and publications linked to this experiment -->
  {(repos.length > 0 || relatedData.length > 0 || relatedPubs.length > 0) && (
    <section class="related">
      <div class="wrap">
        {repos.length > 0 && (
          <div class="block">
            <div class="split-head"><h2>Code repositories</h2></div>
            <ul class="repos">
              {repos.map((r) => (
                <li>
                  <a href={`https://github.com/LIBRA-project/${r.name}`} target="_blank" rel="noopener">{r.name}</a>
                  {r.description && <span><Tbc text={r.description} /></span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {relatedData.length > 0 && (
          <div class="block">
            <div class="split-head"><h2>Datasets on Zenodo</h2></div>
            <table class="records">
              <thead><tr><th scope="col">Record</th><th scope="col">Published</th><th scope="col">DOI</th></tr></thead>
              <tbody>
                {relatedData.map((d) => (
                  <tr>
                    <th scope="row">{d.title}</th>
                    <td class="num">{d.date}</td>
                    <td class="num"><a class="link" href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">{d.doi}</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {relatedPubs.length > 0 && (
          <div class="block">
            <div class="split-head"><h2>Publications and talks</h2></div>
            <div class="pubs">
              {relatedPubs.map((p) => <PublicationItem pub={p} />)}
            </div>
          </div>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  /* The experiment's key colour runs as a band under the header. */
  .identity { border-bottom: 6px solid var(--k); }
  .meta { margin-top: var(--space-lg); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-md); }
  .tagline { color: var(--color-ink-2); }


  /* Three columns: contents, the guide, key facts. The side columns stay in
     view while the guide scrolls. */
  .guide { display: grid; grid-template-columns: 13rem minmax(0, 1fr) 17rem; gap: var(--space-2xl); padding-block: var(--space-2xl) var(--section-gap-s); align-items: start; }
  .guide article { max-width: 75ch; justify-self: center; width: 100%; }
  .toc, .facts { position: sticky; top: var(--space-lg); }
  .toc h2, .facts h2 { font-size: 1.125rem; line-height: 1.3; padding-bottom: var(--space-xs); border-bottom: var(--rule-bar) solid var(--color-rule-2); }
  .toc ul { list-style: none; margin: var(--space-sm) 0 0; padding: 0; }
  .toc li a { display: block; padding-block: var(--space-2xs); color: var(--color-ink-2); text-decoration: none; }
  .toc li a:hover { color: var(--color-accent); text-decoration: underline; }
  .facts dl div { padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .facts dt { font-size: 0.875rem; color: var(--color-muted); }
  .facts dd { margin-top: var(--space-2xs); color: var(--color-ink); }
  @media (max-width: 80rem) {
    .guide { grid-template-columns: minmax(0, 1fr) 17rem; }
    .toc { grid-column: 2; grid-row: 1; position: static; }
    .facts { grid-column: 2; grid-row: 2; position: static; }
    .guide article { grid-column: 1; grid-row: 1 / span 3; }
  }
  @media (max-width: 64rem) {
    .guide { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .toc, .facts, .guide article { grid-column: 1; grid-row: auto; }
    .guide article { order: 3; }
  }

  .lab { padding-block: var(--section-gap-s); border-top: var(--rule-hair) solid var(--color-rule); }
  .lab .split-head h2 { font-size: var(--text-section); }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2xl) var(--gap-columns); }
  @media (max-width: 60rem) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .gallery { grid-template-columns: minmax(0, 1fr); } }

  .related { background: var(--color-paper-2); padding-block: var(--section-gap-s); }
  .block + .block { margin-top: var(--space-3xl); }
  .related .split-head { margin-bottom: var(--space-lg); }
  .related .split-head h2 { font-size: var(--text-section); }
  .repos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap-columns); }
  .repos li { padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .repos a { font: 400 0.9375rem/1.4 var(--font-mono); color: var(--color-accent); overflow-wrap: anywhere; }
  .repos span { display: block; margin-top: var(--space-2xs); font-size: 0.875rem; color: var(--color-muted); }
  @media (max-width: 60rem) { .repos { grid-template-columns: minmax(0, 1fr); } }

  .records { width: 100%; }
  .records thead th { text-align: left; font-size: 0.875rem; font-weight: 400; color: var(--color-muted); padding: 0 var(--space-md) var(--space-xs) 0; border-bottom: var(--rule-bar) solid var(--color-rule-2); }
  .records tbody th, .records td { text-align: left; font-weight: 400; padding: var(--space-sm) var(--space-md) var(--space-sm) 0; border-bottom: var(--rule-hair) solid var(--color-rule); vertical-align: baseline; }
  .records .num { font-size: 0.875rem; white-space: nowrap; }
  @media (max-width: 40rem) {
    .records thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .records, .records tbody, .records tr, .records tbody th, .records td { display: block; }
    .records tr { padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
    .records tbody th, .records td { padding: 0; border: 0; }
  }
  .pubs { border-top: var(--rule-bar) solid var(--color-rule-2); }
</style>
