---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonEntry from '../components/PersonEntry.astro';
import type { Person } from '../components/PersonEntry.astro';
import people from '../data/people.json';
---

<Base title="People">
  <PageHeader
    title="The LIBRA team"
    intro="The scientists, engineers and students behind the LIBRA experiments, and the collaborators we work with."
  />

  <section class="groups">
    <div class="wrap">
      {people.groups.map((group) => (
        <div class="group">
          <div class="split-head">
            <h2>{group.name}</h2>
            {group.description && <p class="desc">{group.description}</p>}
          </div>
          <ul class="members">
            {(group.members as Person[]).map((p) => <PersonEntry person={p} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .groups { padding-block: var(--space-2xl) var(--section-gap); }
  .group + .group { margin-top: var(--section-gap-s); }
  .split-head { margin-bottom: var(--space-md); }
  .desc { color: var(--color-muted); }
  /* Flowing columns, so a group of any size fills without an orphan row. */
  .members { list-style: none; margin: 0; padding: 0; columns: 3; column-gap: var(--gap-columns); }
  .members :global(li) { break-inside: avoid; }
  @media (max-width: 60rem) { .members { columns: 2; } }
  @media (max-width: 40rem) { .members { columns: 1; } }
</style>
